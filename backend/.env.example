APP_NAME=SmartLib
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ==============================================================================
# DATABASE CONFIGURATION (NEON POSTGRESQL CLOUD)
# ==============================================================================
# Option 1: Full Neon Connection String (Recommended)
# Paste your Neon pooled connection string directly here.
DB_CONNECTION=pgsql
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Option 2: Local PostgreSQL Fallback (Uncomment if running local PostgreSQL service)
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=library_db
# DB_USERNAME=postgres
# DB_PASSWORD=your_password
# DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ==============================================================================
# AI LIBRARIAN & EXTERNAL API KEYS (OPTIONAL)
# ==============================================================================
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Safaricom Daraja M-Pesa STK Push Credentials (Sandbox)
DARAJA_ENV=sandbox
DARAJA_KEY=
DARAJA_SECRET=
DARAJA_PASSKEY=
DARAJA_SHORTCODE=174379

VITE_APP_NAME="${APP_NAME}"

